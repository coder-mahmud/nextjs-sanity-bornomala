generator client {
  provider      = "prisma-client"
  output        = "../prisma/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  name               String?
  email              String              @unique
  emailVerified      DateTime?
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  password           String?
  role               Role                @default(STUDENT)
  accounts           Account[]
  authenticators     Authenticator[]
  couponUsages       CouponUsage[]
  courseAccesses     CourseAccess[]
  courseCertificates CourseCertificate[]
  lessonProgress     LessonProgress[]
  payments           Payment[]
  quizAccesses       QuizAccess[]
  quizAttempts       QuizAttempt[]
  sessions           Session[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Course {
  id               String       @id @default(cuid())
  title            String
  slug             String       @unique
  description      String?
  shortDescription String?
  tagLine          String?
  level            String?
  thumbnail        String?
  price            Decimal      @db.Decimal(10, 2)
  currency         String?      @default("EUR")
  status           CourseStatus @default(DRAFT)
  characteristics  String[]
  targetAudience   String[]
  duration         String?
  numberOfStudents String?
  rating           String?
  order            Int?
  
  // JSON array storing course-specific FAQs: [{ question: string, answer: string }]
  faqs             Json?

  instructorId     String?
  instructor       Instructor?  @relation(fields: [instructorId], references: [id], onDelete: SetNull)

  // Schedules
  parisScheduleId  String?
  parisSchedule    Schedule?    @relation("ParisSchedule", fields: [parisScheduleId], references: [id], onDelete: SetNull)

  hocheScheduleId  String?
  hocheSchedule    Schedule?    @relation("HocheSchedule", fields: [hocheScheduleId], references: [id], onDelete: SetNull)

  cards            CourseCard[]
  batches          Batch[]

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  accesses         CourseAccess[]
  courseCertificates CourseCertificate[]
  payments         Payment[]

  @@index([status])
}

model Batch {
  id              String      @id @default(cuid())
  courseId        String
  title           String      // e.g. "Batch 01 - Spring 2026"
  slug            String      @unique
  startDate       DateTime?
  endDate         DateTime?   // Batch access expiry threshold
  
  meetingPlatform String?     // e.g. "ZOOM", "GOOGLE_MEET"
  meetingLink     String?     // Fixed class URL
  meetingPassword String?     // Passcode

  maxStudents     Int?
  status          BatchStatus @default(UPCOMING)

  course          Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons         Lesson[]
  accesses        CourseAccess[]
  payments        Payment[]

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([courseId])
  @@index([status])
}

model Lesson {
  id              String           @id @default(cuid())
  batchId         String?          
  quizId          String?          
  title           String
  slug            String           @unique
  description     String?
  videoUrl        String?
  order           Int
  isPreview       Boolean          @default(false)
  
  startsAt        DateTime?
  endsAt          DateTime?

  bunnyLibraryId  String?
  bunnyVideoId    String?

  attachments     String[]         
  notes           String?          

  batch           Batch?           @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quiz            Quiz?            @relation(fields: [quizId], references: [id], onDelete: SetNull)
  progressRecords LessonProgress[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([batchId, order])
  @@index([batchId])
  @@index([quizId])
}

model Quiz {
  id              String        @id @default(cuid())
  title           String
  slug            String        @unique
  description     String?
  price           Decimal       @default(0) @db.Decimal(10, 2)
  currency        String        @default("EUR")
  durationMinutes Int           
  maxAttempts     Int           @default(1)
  passingScore    Int           @default(50)
  status          QuizStatus    @default(DRAFT)
  
  lessons         Lesson[]      
  payments        Payment[]
  questions       Question[]
  accesses        QuizAccess[]
  attempts        QuizAttempt[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  isCompleted Boolean  @default(false)
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
}

model Question {
  id          String              @id @default(cuid())
  quizId      String
  text        String
  explanation String?
  order       Int
  marks       Int                 @default(1)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  quiz        Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options     QuestionOption[]
  answers     QuizAttemptAnswer[]

  @@unique([quizId, order])
  @@index([quizId])
}

model QuestionOption {
  id         String              @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean             @default(false)
  order      Int
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  question   Question            @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIn QuizAttemptAnswer[]

  @@unique([questionId, order])
  @@index([questionId])
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  courseId        String?
  batchId         String?
  quizId          String?
  provider        String        @default("stripe")
  paypalOrderId   String?       @unique
  paypalCaptureId String?       @unique
  stripeIntentId  String?       @unique
  stripeSessionId String?       @unique
  amount          Decimal       @db.Decimal(10, 2)
  currency        String        @default("EUR")
  status          PaymentStatus @default(CREATED)
  paidAt          DateTime?
  rawResponse     Json?
  
  couponUsages    CouponUsage[]
  courseAccess    CourseAccess?
  course          Course?       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch           Batch?        @relation(fields: [batchId], references: [id], onDelete: SetNull)
  quiz            Quiz?         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizAccess      QuizAccess?

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([quizId])
  @@index([courseId])
  @@index([batchId])
}

model CourseAccess {
  id        String    @id @default(cuid())
  userId    String
  courseId  String
  batchId   String?
  grantedAt DateTime  @default(now())
  expiresAt DateTime? 
  paymentId String?   @unique
  
  course    Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  batch     Batch?    @relation(fields: [batchId], references: [id], onDelete: SetNull)
  payment   Payment?  @relation(fields: [paymentId], references: [id])
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([courseId])
  @@index([batchId])
}

model QuizAccess {
  id        String    @id @default(cuid())
  userId    String
  quizId    String
  paymentId String?   @unique
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  payment   Payment?  @relation(fields: [paymentId], references: [id])
  quiz      Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quizId])
  @@index([userId])
  @@index([quizId])
}

model QuizAttempt {
  id              String              @id @default(cuid())
  userId          String
  quizId          String
  status          AttemptStatus       @default(STARTED)
  startedAt       DateTime            @default(now())
  submittedAt     DateTime?
  score           Int?
  totalMarks      Int?
  percentage      Float?
  passed          Boolean?
  resultPublished Boolean             @default(true)
  
  quiz            Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         QuizAttemptAnswer[]

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([userId, quizId])
  @@index([userId])
  @@index([quizId])
}

model QuizAttemptAnswer {
  id               String          @id @default(cuid())
  attemptId        String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean?
  awardedMarks     Int?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  attempt          QuizAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question         Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
}

model CourseCertificate {
  id            String   @id @default(cuid())
  userId        String
  courseId      String
  certificateNo String   @unique
  issuedAt      DateTime @default(now())
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

model Coupon {
  id        String        @id @default(cuid())
  code      String        @unique
  type      CouponType
  value     Decimal       @db.Decimal(10, 2)
  active    Boolean       @default(true)
  maxUses   Int?
  usedCount Int           @default(0)
  startsAt  DateTime?
  expiresAt DateTime?
  courseId  String?
  quizId    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  usages    CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  paymentId String?
  usedAt    DateTime @default(now())
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  payment   Payment? @relation(fields: [paymentId], references: [id])
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
}

model Branch {
  id      String  @id @default(cuid())
  name    String
  address String?

  schedules Schedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Schedule {
  id String @id @default(cuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  level       String?
  description String?

  entries ScheduleEntry[]

  // Relations to Course
  parisCourses Course[] @relation("ParisSchedule")
  hocheCourses Course[] @relation("HocheSchedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId])
}

model ScheduleEntry {
  id String @id @default(cuid())

  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  day          String   // e.g. "সোমবার" or "MONDAY"
  time         String   // e.g. "সকাল ১১:০০ টা - ০২:০০ টা" or "11:00 AM - 02:00 PM"
  startingDate String   // e.g. "০৫ ডিসেম্বর" or "05 December 2026"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scheduleId])
}

model CourseCard {
  id String @id @default(cuid())

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  image       String?
  title       String
  description String?
  order       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
  @@index([courseId])
}

model Instructor {
  id String @id @default(cuid())

  name        String
  title       String?
  designation String?
  experience  String?

  studentCount Int      @default(0)
  courseCount  Int      @default(0)
  rating       Decimal? @db.Decimal(3, 2)

  description String?

  imageUrl      String?
  imagePublicId String?

  tags String[]

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  STUDENT
  USER
  ADMIN
  SUPERADMIN
}

enum BatchStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  CREATED
  APPROVED
  CAPTURED
  FAILED
  REFUNDED
}

enum AttemptStatus {
  STARTED
  SUBMITTED
  EVALUATED
}

enum CouponType {
  PERCENT
  FIXED
}

enum WeekDay {
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
}